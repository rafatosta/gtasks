{
  "id": "io.github.rafatosta.gtasks",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "gtasks",
  "finish-args": [
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--share=network",
    "--talk-name=org.gnome.OnlineAccounts"
  ],
  "modules": [
    {
      "name": "libspelling",
      "buildsystem": "meson",
      "config-opts": [
        "-Ddocs=false",
        "-Dvapi=false",
        "-Dsysprof=false",
        "-Dintrospection=enabled"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://gitlab.gnome.org/GNOME/libspelling.git",
          "tag": "0.4.10",
          "commit": "1facdde8e1c0fd72bed806f9a9be2fbec83af5f2"
        }
      ]
    },
    {
      "name": "gtasks",
      "buildsystem": "meson",
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ]
}
