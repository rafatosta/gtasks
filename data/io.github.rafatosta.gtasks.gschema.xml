<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="gtasks">
  <schema id="io.github.rafatosta.gtasks" path="/io/github/rafatosta/gtasks/">
    <key name="sync-on-startup" type="b">
      <default>true</default>
      <summary>Synchronize Google accounts on startup</summary>
    </key>
    <key name="sync-interval" type="i">
      <default>15</default>
      <summary>Minutes between background synchronizations (0 disables it)</summary>
    </key>
    <key name="show-completed" type="b">
      <default>true</default>
      <summary>Display completed tasks</summary>
    </key>
    <key name="restore-last-list" type="b">
      <default>true</default>
      <summary>Restore the previously selected list</summary>
    </key>
    <key name="spell-check-enabled" type="b">
      <default>true</default>
      <summary>Check spelling in editable text fields</summary>
    </key>
    <key name="spelling-language" type="s">
      <default>'pt_BR'</default>
      <summary>Dictionary used for spelling suggestions</summary>
    </key>
    <key name="last-source" type="s">
      <default>''</default>
      <summary>Source of the last selected list</summary>
    </key>
    <key name="last-list-id" type="s">
      <default>''</default>
      <summary>Identifier of the last selected list</summary>
    </key>
  </schema>
</schemalist>
