<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.rafatosta.gtasks</id>
  <name>GTasks</name>
  <summary>Tasks for GNOME</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>Manage local and Google Tasks lists in one native GNOME application. Previously synchronized tasks can be viewed offline.</p>
  </description>
  <launchable type="desktop-id">io.github.rafatosta.gtasks.desktop</launchable>
  <developer id="io.github.rafatosta">
    <name translate="no">Rafael Tosta</name>
  </developer>
  <url type="homepage">https://github.com/rafatosta/gtasks</url>
  <url type="bugtracker">https://github.com/rafatosta/gtasks/issues</url>
  <screenshots>
    <screenshot type="default">
      <caption>Organize local tasks and Google Tasks lists</caption>
